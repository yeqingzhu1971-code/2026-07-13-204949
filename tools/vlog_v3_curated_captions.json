[
  {"start":4.270,"end":5.510,"text":"薯条要吗？"},
  {"start":6.010,"end":7.330,"text":"我没有那么想。"},
  {"start":25.360,"end":26.080,"text":"我去，又开始。"},
  {"start":28.230,"end":29.490,"text":"这是 duty，是吗？"},
  {"start":30.110,"end":31.000,"text":"对。什么意思？"},
  {"start":31.400,"end":34.900,"text":"责任，责任。那为什么？哦，限重吧。"},
  {"start":34.900,"end":35.740,"text":"对。"},
  {"start":36.460,"end":39.670,"text":"还有税收，也是 duty。"},
  {"start":39.670,"end":41.650,"text":"免税叫 duty free。"},
  {"start":41.950,"end":43.970,"text":"知道了吗？Duty free。"},
  {"start":44.840,"end":47.800,"text":"这就是明阳的打卡。拍照，拍照！"},
  {"start":49.330,"end":51.070,"text":"那个是什么？这就是 A 室。"},
  {"start":51.590,"end":53.050,"text":"这就是 A 室。"},
  {"start":53.720,"end":54.980,"text":"这可以吗？"},
  {"start":55.740,"end":56.740,"text":"这也挺不错的。"},
  {"start":57.680,"end":58.900,"text":"好好好，太好了。"},
  {"start":85.660,"end":88.120,"text":"应该是那边的公寓吧。"},
  {"start":89.520,"end":90.760,"text":"这是那个外卖柜。"},
  {"start":90.760,"end":92.780,"text":"他在这儿住了一个多月。"},
  {"start":92.960,"end":94.600,"text":"当时我跟严哥在外头。"},
  {"start":94.600,"end":96.160,"text":"你们俩喝酒那时候，"},
  {"start":96.250,"end":98.670,"text":"然后我们俩当时都愣住了。"},
  {"start":98.670,"end":99.310,"text":"你知道吧？"},
  {"start":99.350,"end":100.690,"text":"看到那个都震惊了。"},
  {"start":101.850,"end":102.670,"text":"还有十分钟。"},
  {"start":103.110,"end":104.270,"text":"十分钟？"},
  {"start":104.270,"end":104.990,"text":"下雨了吗？"},
  {"start":105.240,"end":107.500,"text":"下雨了，快走快走！"},
  {"start":108.760,"end":109.820,"text":"意大利国旗。"},
  {"start":109.820,"end":111.100,"text":"你哪知道意大利国旗？"},
  {"start":115.540,"end":116.640,"text":"横着是匈牙利，"},
  {"start":116.640,"end":118.130,"text":"竖着是意大利。"},
  {"start":120.110,"end":122.430,"text":"你说这车会不会从意大利开过来？"},
  {"start":122.430,"end":124.850,"text":"每次我不是没空，"},
  {"start":124.850,"end":126.110,"text":"就是我说我有空，"},
  {"start":126.110,"end":127.610,"text":"但是他都不会让我去。"},
  {"start":127.990,"end":129.330,"text":"最后都不会有我。"},
  {"start":129.330,"end":129.780,"text":"为什么？"},
  {"start":129.780,"end":130.870,"text":"因为就是……"},
  {"start":130.870,"end":132.770,"text":"现在已经是……"},
  {"start":134.170,"end":135.670,"text":"十二点四十六分。"},
  {"start":138.240,"end":139.200,"text":"我饿了。"},
  {"start":140.370,"end":140.910,"text":"吃啥呀？"},
  {"start":140.950,"end":142.680,"text":"家里都有啥呀？"},
  {"start":142.680,"end":143.400,"text":"那……"},
  {"start":147.020,"end":148.460,"text":"我想吃……"},
  {"start":149.570,"end":151.390,"text":"还有啥？"},
  {"start":152.690,"end":154.470,"text":"还有米饭、皮蛋。"},
  {"start":154.470,"end":156.230,"text":"那做个蛋炒饭吧。"},
  {"start":157.030,"end":158.130,"text":"可以，没问题。"},
  {"start":159.120,"end":161.520,"text":"感谢你，谢谢你。"},
  {"start":161.520,"end":162.240,"text":"有你真好。"},
  {"start":162.240,"end":163.800,"text":"我要去做饭了。"}
]
